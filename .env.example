# ─── Sistema de Ponto Online ─────────────────────────────────────────────
# Ambiente de Desenvolvimento

APP_NAME="Sistema de Ponto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# ─── Logging ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ponto_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# ─── Cache ──────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=ponto_cache_

# ─── Session ────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue ──────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── Mail ───────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ponto.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum (API Auth) ────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8000
SANCTUM_GUARD=web

# ─── Hashing ───────────────────────────────────────────────────────────
# Argon2id é o driver padrão para conformidade OWASP
HASH_DRIVER=argon2id

# ─── Fortify (MFA/TOTP) ────────────────────────────────────────────────
FORTIFY_FEATURES_TWO_FACTOR=true

# ─── Filament ──────────────────────────────────────────────────────────
FILAMENT_PATH=admin

# ─── CORS ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ─── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5

# ─── Encryption (PII/LGPD) ─────────────────────────────────────────────
# APP_KEY é usado para encriptação AES-256-CBC de dados sensíveis
# Gere com: php artisan key:generate
